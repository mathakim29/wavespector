{
  "name": "wavespector",
  "version": "0.1.0",
  "description": "App to run audio seperation models",
  "type": "module",
  "bin": {
    "wavespector": "bin/wavespector.js"
  },
  "files": [
    "api.py",
    "app",
    "index.html",
    "vite.config.js",
    "bin",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "uv run api.py",
    "build": "vite build"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "npm-run-all2": "^9.0.4",
    "svelte": "^5.0.0",
    "toastify-js": "^1.12.0",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
